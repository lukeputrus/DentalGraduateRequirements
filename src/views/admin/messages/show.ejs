<%- include('../../partials/header', { title: student.full_name }) %>
<div class="page-header">
  <h1 class="mt-0">Messages with <%= student.full_name %></h1>
  <div class="form-row" style="max-width: 320px;">
    <a class="btn" href="/admin/messages">&larr; All messages</a>
    <a class="btn" href="/admin/students/<%= student.id %>">View student</a>
  </div>
</div>

<div class="card">
  <div class="requirement-list">
    <% if (thread.length === 0) { %>
      <p class="muted">No messages yet.</p>
    <% } %>
    <% thread.forEach(function (m) { %>
      <div class="requirement-item">
        <div class="requirement-main">
          <strong><%= m.sender === 'student' ? student.full_name : 'You' %></strong>
          <span class="muted"><%= m.created_at %></span>
        </div>
        <p class="mt-0"><%= m.body %></p>
        <% if (m.attachment_name) { %>
          <p><a href="/admin/messages/attachment/<%= m.id %>"><svg class="icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg> <%= m.attachment_name %></a></p>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<div class="card">
  <h2 class="mt-0">Reply</h2>
  <form method="POST" action="/admin/messages/<%= student.id %>/reply" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Message
      <textarea name="message" rows="3" placeholder="Type your reply…"></textarea>
    </label>
    <label>Attach a file (optional)
      <input type="file" name="attachment" accept=".pdf,image/png,image/jpeg,image/webp,image/gif">
    </label>
    <button type="submit" class="btn btn-primary">Send reply</button>
  </form>
</div>
<%- include('../../partials/footer') %>
