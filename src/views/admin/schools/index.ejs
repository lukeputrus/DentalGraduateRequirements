<%- include('../../partials/header', { title: 'Manage Schools' }) %>
<div class="phead">
  <h1>Dental Schools</h1>
  <p class="sub">This list powers the dropdown students use to select their school. Each school can have its own institution theme; students and staff see their school's theme unless they pick another from the top bar.</p>
</div>
<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>

<div class="card">
  <h2 class="mt-0">Add a school</h2>
  <form method="POST" action="/admin/schools" class="form-row">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>School name
      <input type="text" name="name" placeholder="e.g. University of Example School of Dentistry" required>
    </label>
    <div class="align-end">
      <button type="submit" class="btn btn-primary">Add school</button>
    </div>
  </form>
</div>

<div class="card">
  <table>
    <thead><tr><th>School</th><th class="r">Students</th><th class="r">Competencies</th><th>Theme</th><th></th></tr></thead>
    <tbody>
      <% schools.forEach(function (school) { %>
        <tr>
          <td><%= school.name %></td>
          <td class="r"><%= school.student_count %></td>
          <td class="r"><%= school.competency_count %></td>
          <td>
            <form method="POST" action="/admin/schools/<%= school.id %>/theme" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="theme" data-autosubmit aria-label="Theme for <%= school.name %>">
                <option value="">App default</option>
                <% themeOptions.forEach(function (t) { %><option value="<%= t.key %>" <%= school.theme === t.key ? 'selected' : '' %>><%= t.label %></option><% }) %>
              </select>
              <noscript><button type="submit" class="btn btn-small">Set</button></noscript>
            </form>
          </td>
          <td class="actions-cell text-right">
            <a class="btn btn-small" href="/admin/competencies?school_id=<%= school.id %>">Competencies</a>
            <% if (school.student_count === 0) { %>
            <form method="POST" action="/admin/schools/<%= school.id %>/delete" class="inline-form" data-confirm="Remove <%= school.name %>?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-small btn-danger">Remove</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../../partials/footer') %>
