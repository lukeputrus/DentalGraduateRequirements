<%- include('../partials/header', { title: 'Log in' }) %>
<div class="auth-card">
  <h1>Log in</h1>
  <p class="muted">Dental Graduate Requirements Tracker</p>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="POST" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Username
      <input type="text" name="username" value="<%= username %>" autofocus required autocomplete="username">
    </label>
    <label>Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn btn-primary">Log in</button>
  </form>
  <% if (locals.demoAccounts) { %>
  <div class="demo-logins">
    <p><strong>Demo logins</strong> (password for all: <code><%= demoPassword %></code>)</p>
    <ul>
      <% demoAccounts.forEach(function (a) { %>
        <li><code><%= a.username %></code>: <%= a.label %></li>
      <% }) %>
    </ul>
    <p class="muted">Demo data resets whenever the server restarts.</p>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
