<%- include('../partials/header', { title: 'Something went wrong' }) %>
<div class="card">
  <h1>Something went wrong</h1>
  <p class="muted">An unexpected error occurred. Please try again.</p>
  <% if (typeof message !== 'undefined' && message) { %><pre class="muted"><%= message %></pre><% } %>
  <a class="btn btn-primary" href="/">Go home</a>
</div>
